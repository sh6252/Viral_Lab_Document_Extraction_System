{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virology-lab-idp.local/schemas/ground_truth.schema.json",
  "title": "Virology Lab IDP Ground Truth Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_set", "source_document", "logical_forms"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_set": {
      "enum": ["dev", "holdout"]
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "page_count"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "page_count": { "type": "integer", "minimum": 1 }
      }
    },
    "logical_forms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/logical_form" }
    }
  },
  "$defs": {
    "logical_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_id", "page_indices", "fields"],
      "properties": {
        "form_id": { "type": "string", "minLength": 1 },
        "page_indices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_name",
            "last_name",
            "israeli_id",
            "central_numbers",
            "sample_receipt_date",
            "sender",
            "commitment_numbers"
          ],
          "properties": {
            "first_name": { "$ref": "#/$defs/field_truth" },
            "last_name": { "$ref": "#/$defs/field_truth" },
            "israeli_id": { "$ref": "#/$defs/field_truth" },
            "central_numbers": { "$ref": "#/$defs/field_truth" },
            "sample_receipt_date": { "$ref": "#/$defs/field_truth" },
            "sender": { "$ref": "#/$defs/field_truth" },
            "commitment_numbers": { "$ref": "#/$defs/field_truth" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "field_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_status", "value_status", "values"],
      "properties": {
        "annotation_status": {
          "enum": ["verified", "unverified"]
        },
        "value_status": {
          "enum": ["present", "absent", "unknown", "not_annotated", "unreadable", "ambiguous", "not_applicable"],
          "description": "Use absent only for verified ground-truth absence. Keep unknown and unverified annotation states distinct from absence."
        },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_value" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "notes": { "type": "string" }
      }
    },
    "field_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw"],
      "properties": {
        "raw": {
          "type": "string",
          "description": "Untouched source value. Preserve leading zeros and intentionally invalid demo identifiers."
        },
        "normalized": {
          "type": "string",
          "description": "Optional deterministic normalized value. Must remain a string."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_index", "source_kind"],
      "properties": {
        "page_index": { "type": "integer", "minimum": 0 },
        "source_kind": {
          "enum": ["ocr_text", "vision_model", "barcode", "sticker", "stamp", "handwriting", "manual_review"]
        },
        "bounding_box": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "text_snippet": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
