# Copy this file to .env for local development.
# Do not commit real credentials, API keys, patient data paths, or provider secrets.

# External AI access is disabled by default.
AI_OUTBOUND_ENABLED=false
ALLOW_EXTERNAL_PHI=false
APPROVED_AI_PROVIDERS=

# Default extraction path should remain local unless explicitly changed.
DEFAULT_EXTRACTION_ADAPTER=local_ocr
MAX_UPLOAD_BYTES=20971520
EXTRACTION_PIPELINE_VERSION=api-v1

# Gemini is optional and must stay disabled unless explicitly approved.
# A key alone does not authorize outbound AI or PHI transmission.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Experimental schema enforcement; does not grant external-processing approval.
# Keep false until separately authorized model/schema feasibility evaluation.
GEMINI_STRUCTURED_OUTPUTS_EXPERIMENTAL=false
