# Copy this file to .env for local development.
# Do not commit real credentials, API keys, patient data paths, or provider secrets.

# External AI access is disabled by default.
AI_OUTBOUND_ENABLED=false
ALLOW_EXTERNAL_PHI=false
APPROVED_AI_PROVIDERS=

# Default extraction path should remain local unless explicitly changed.
DEFAULT_EXTRACTION_ADAPTER=local_ocr
MAX_UPLOAD_BYTES=20971520
EXTRACTION_PIPELINE_VERSION=api-v1

# Gemini is optional and must stay disabled unless explicitly approved.
# A key alone does not authorize outbound AI or PHI transmission.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Experimental schema enforcement; does not grant external-processing approval.
# Keep false until separately authorized model/schema feasibility evaluation.
GEMINI_STRUCTURED_OUTPUTS_EXPERIMENTAL=false

# Optional cloud factory only. These do not change the local demo launcher.
# Render's RENDER_EXTERNAL_URL supplies the exact HTTPS origin when override is blank.
APP_DEPLOYMENT=local
DEMO_DATA_POLICY=synthetic-only
DEMO_PUBLIC_ORIGIN=
DEMO_DATABASE_NAME=viral_lab_submission_synthetic
# Backend-only: python -m backend.tools.demo_password (never use a VITE_ name).
DEMO_PASSWORD_HASH=
# Backend-only direct Neon DSN, sslmode=require&channel_binding=require; no -pooler host.
REVIEW_DATABASE_DSN=
# Empty means no uploads are approved; comma-separated SHA-256 of approved synthetic files.
DEMO_ALLOWED_DOCUMENT_SHA256=
# Render cloud requires MAX_UPLOAD_BYTES <= 5242880, unlike the 20 MiB local default.
